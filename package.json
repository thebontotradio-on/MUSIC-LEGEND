{
  "name": "bontot-music-legend",
  "version": "1.0.0",
  "description": "MUSIC LEGEND LIVE — THE BONTOT RADIO (Interactive TikTok LIVE Music Quiz Game)",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "tiktok-live",
    "music-quiz",
    "threejs",
    "interactive-game",
    "bontot-radio"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
